void moveServos(int j1, int j2, int j3, int j4) {
    servoJ1.write(j1);
    servoJ2.write(j2);
    servoJ3.write(j3);
    servoJ4.write(j4);
}

void recordStep(int j1, int j2, int j3, int j4) {
    File file = LittleFS.open(tempFile, FILE_APPEND);
    if (!file) return;
    file.printf("%d,%d,%d,%d\n", j1, j2, j3, j4);
    file.close();
}

void startPlayback(String sequenceName) {
    String filePath = "/" + sequenceName + ".csv";
    playbackFile = LittleFS.open(filePath, FILE_READ);
    
    if (!playbackFile) {
        ws.textAll("{\"type\":\"status\",\"msg\":\"Sequence not found.\"}");
        return;
    }
    isPlaying = true;
    ws.textAll("{\"type\":\"status\",\"msg\":\"Executing Playback: " + sequenceName + "\"}");
}

void sendSequenceList() {
    File root = LittleFS.open("/");
    File file = root.openNextFile();
    
    String jsonList = "{\"type\":\"list\",\"files\":[";
    bool first = true;
    
    while(file) {
        String fname = file.name();
        if(fname.endsWith(".csv") && fname != "temp.csv") {
            if(!first) jsonList += ",";
            fname.replace(".csv", ""); 
            jsonList += "\"" + fname + "\"";
            first = false;
        }
        file = root.openNextFile();
    }
    jsonList += "]}";
    ws.textAll(jsonList);
}

void handleWebSocketMessage(void *arg, uint8_t *data, size_t len) {
    AwsFrameInfo *info = (AwsFrameInfo*)arg;
    if (info->final && info->index == 0 && info->len == len && info->opcode == WS_TEXT) {
        data[len] = 0;
        StaticJsonDocument<512> doc;
        DeserializationError error = deserializeJson(doc, data);
        if (error) return;

        String action = doc["action"];

        if (action == "move" && !isPlaying) {
            int j1 = doc["j1"]; int j2 = doc["j2"];
            int j3 = doc["j3"]; int j4 = doc["j4"];
            moveServos(j1, j2, j3, j4);
            
            // FIXED: Do not save file here! Flag it for the main loop to save.
            if (isRecording) {
                recJ1 = j1; recJ2 = j2; recJ3 = j3; recJ4 = j4;
                pendingRecord = true; 
            }
        } 
        else if (action == "start_record" && !isPlaying) {
            LittleFS.remove(tempFile);
            isRecording = true;
        } 
        else if (action == "stop_record") {
            isRecording = false;
        }
        else if (action == "save") {
            String seqName = doc["name"];
            String finalPath = "/" + seqName + ".csv";
            LittleFS.rename(tempFile, finalPath);
            sendSequenceList();
            ws.textAll("{\"type\":\"status\",\"msg\":\"Saved sequence: " + seqName + "\"}");
        }
        else if (action == "list") {
            sendSequenceList();
        }
        else if (action == "start_playback") {
            if (!isRecording && !isPlaying) {
                String seqName = doc["name"];
                startPlayback(seqName);
            }
        }
        else if (action == "stop_playback") {
            if(isPlaying) {
                isPlaying = false;
                if(playbackFile) playbackFile.close();
                ws.textAll("{\"type\":\"status\",\"msg\":\"Playback finished.\"}");
            }
        }
        else if (action == "delete") {
            String seqName = doc["name"];
            String filePath = "/" + seqName + ".csv";
            LittleFS.remove(filePath);
            sendSequenceList();
            ws.textAll("{\"type\":\"status\",\"msg\":\"Deleted: " + seqName + "\"}");
        }
    }
}

void onEvent(AsyncWebSocket *server, AsyncWebSocketClient *client, AwsEventType type,
             void *arg, uint8_t *data, size_t len) {
    if (type == WS_EVT_DATA) {
        handleWebSocketMessage(arg, data, len);
    }
}

void setup() {
    Serial.begin(115200);

    if (!LittleFS.begin(true)) {
        Serial.println("An Error has occurred while mounting LittleFS");
        return;
    }

    ESP32PWM::allocateTimer(0); ESP32PWM::allocateTimer(1);
    ESP32PWM::allocateTimer(2); ESP32PWM::allocateTimer(3);
    servoJ1.setPeriodHertz(50); servoJ2.setPeriodHertz(50);
    servoJ3.setPeriodHertz(50); servoJ4.setPeriodHertz(50);
    
    servoJ1.attach(pinJ1, 500, 2400); servoJ2.attach(pinJ2, 500, 2400);
    servoJ3.attach(pinJ3, 500, 2400); servoJ4.attach(pinJ4, 500, 2400);

    moveServos(90, 90, 90, 90);

    WiFi.softAP(ssid, password);
    IPAddress IP = WiFi.softAPIP();
    Serial.print("AP IP address: ");
    Serial.println(IP);

    ws.onEvent(onEvent);
    server.addHandler(&ws);
    
    server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
        request->send_P(200, "text/html", index_html);
    });

    // ========================================================
    // NEW: ROUTE TO RECEIVE OBJECT NAME FROM AMB82-MINI CAMERA
    // ========================================================
    server.on("/trigger", HTTP_GET, [](AsyncWebServerRequest *request) {
        if (request->hasParam("obj")) {
            String objName = request->getParam("obj")->value();
            objName.trim(); // Clean up hidden formatting spaces
            
            // Displays the incoming object name cleanly on your Serial Monitor
            Serial.println("\n[Wi-Fi Received] Camera detected object: '" + objName + "'");
            
            // Pass the string to our comparison & file execution scanner
            handleTrigger(objName); 
            
            request->send(200, "text/plain", "Received object: " + objName);
        } else {
            request->send(400, "text/plain", "Error: Missing 'obj' parameter");
        }
    });
    // ========================================================

    server.begin();
}
bool isBusy = false;
// Add this check inside your handleTrigger function
void handleTrigger(String objName) {
    // 1. Safety check: Is the arm already moving?
    if (isPlaying) { 
        Serial.println("-> Trigger Ignored: Robotic arm is busy running a sequence.");
        return; 
    }

    // 2. Clean up the incoming object name text format
    objName.trim();
    objName.replace(".csv", "");
    if (objName.startsWith("/")) {
        objName.remove(0, 1);
    }

    Serial.println("\n[Dynamic Lookup] Searching LittleFS for object: '" + objName + "'");

    // 3. Build the paths to search storage dynamically
    String pathWithExt = "/" + objName + ".csv";
    String pathRaw = "/" + objName;

    // 4. Check if a matching dashboard file actually exists
    if (LittleFS.exists(pathWithExt) || LittleFS.exists(pathRaw)) {
        Serial.println("-> [MATCH FOUND] Found a saved sequence profile for: " + pathWithExt);
        Serial.println("-> Launching physical playback sequence now...");
        
        // Pass the clean name directly to your playback engine!
        startPlayback(objName); 
    } 
    else {
        // If the camera sees an object but you haven't made a sequence for it yet:
        Serial.print("-> [NO MATCH] Looked for '" + pathWithExt + "' but it doesn't exist. ");
        Serial.println("Go to your web dashboard, record a movement, and save it exactly as '" + objName + "'");
    }
}

void loop() {

 if (Serial.available() > 0) {
        String input = Serial.readStringUntil('\n');
        input.trim(); // Remove hidden carriage returns (\r) and spaces
        
        if (input.length() > 0) {
            Serial.println("\n[Serial Input] Checking storage for: '" + input + "'");
            
            // 1. Clean the incoming string to match your dashboard format
            String cleanName = input;
            cleanName.replace(".csv", "");
            if (cleanName.startsWith("/")) {
                cleanName.remove(0, 1);
            }

            // 2. Map and check all path possibilities against LittleFS
            String variantRaw = input;
            String variantWithSlash = "/" + input;
            String variantWithExt = input + ".csv";
            String variantWithBoth = "/" + input + ".csv";
            
            bool fileExists = false;
            if (LittleFS.exists(variantRaw) || LittleFS.exists(variantWithSlash) || 
                LittleFS.exists(variantWithExt) || LittleFS.exists(variantWithBoth)) {
                fileExists = true;
            }

            // 3. Fire the playback trigger if a valid match is found
            if (fileExists) {
                Serial.print("-> Success! Found file. Triggering playback for clean name: ");
                Serial.println(cleanName);
                
                // Passes clean name (e.g. "Clamper") directly into your arm sequence
                handleTrigger(cleanName); 
            } else {
                Serial.println("-> ERROR: File not found in LittleFS. Check your spelling.");
            }
        }
    }
    // --- 1. Handle file saving ---
    if (pendingRecord) {
        pendingRecord = false; 
        recordStep(recJ1, recJ2, recJ3, recJ4);
    }

    // --- 2. Playback Logic with "Busy" Lock ---
    if (isPlaying) {
        isBusy = true; // Lock the system while playing
        
        if (millis() - lastStepTime >= stepDelay) {
            lastStepTime = millis();
            
            if (playbackFile.available()) {
                String line = playbackFile.readStringUntil('\n');
                if (line.length() > 0) {
                    int j1, j2, j3, j4;
                    if (sscanf(line.c_str(), "%d,%d,%d,%d", &j1, &j2, &j3, &j4) == 4) {
                        moveServos(j1, j2, j3, j4);
                        
                        char syncData[128];
                        snprintf(syncData, sizeof(syncData), "{\"type\":\"sync\",\"j1\":%d,\"j2\":%d,\"j3\":%d,\"j4\":%d}", j1, j2, j3, j4);
                        ws.textAll(syncData);
                    }
                }
            } else {
                // Playback finished
                isPlaying = false;
                isBusy = false; // Unlock the system
                playbackFile.close();
                ws.textAll("{\"type\":\"status\",\"msg\":\"Playback finished.\"}");
            }
        }
    }
}
